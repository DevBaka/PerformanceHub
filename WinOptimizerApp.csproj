<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PerformanceHub</AssemblyName>
    <RootNamespace>PerformanceHub</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config\applications.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config\tweaks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  
  <!-- Kill any running instance before build to avoid MSB3021/MSB3027 file lock errors -->
  <Target Name="KillRunningDJWinOptimizer" BeforeTargets="BeforeBuild">
    <!-- Try PowerShell first for quiet stop; ignore errors if not running -->
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Get-Process PerformanceHub -ErrorAction SilentlyContinue | Stop-Process -Force&quot;" ContinueOnError="true" />
    <!-- Fallback to taskkill; ignore errors if process not found -->
    <Exec Command="taskkill /IM PerformanceHub.exe /F" ContinueOnError="true" />
  </Target>
</Project>
