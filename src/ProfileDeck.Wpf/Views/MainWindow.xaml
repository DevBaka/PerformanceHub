<Window x:Class="ProfileDeck.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProfileDeck" Height="650" Width="950" MinHeight="450" MinWidth="700"
        Background="#1E1F22" Foreground="#E3E5E8"
        Closing="Window_Closing">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Display-Profile">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="DisplayProfileList" Grid.Column="0"
                             ItemsSource="{Binding DisplayProfiles}"
                             SelectedItem="{Binding SelectedDisplayProfile}"
                             DisplayMemberPath="Name"
                             MouseDoubleClick="DisplayProfileList_MouseDoubleClick"/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="170">
                        <Button Content="Anwenden" Click="ApplyDisplayProfile_Click"/>
                        <Button Content="Dry-Run" Click="DryRunDisplayProfile_Click"/>
                        <Separator Margin="0,8"/>
                        <Button Content="Neu (aktuelle Anordnung)" Click="NewDisplayProfileFromCurrent_Click"/>
                        <Button Content="Neu (leer)" Click="NewDisplayProfileEmpty_Click"/>
                        <Button Content="Bearbeiten" Click="EditDisplayProfile_Click"/>
                        <Button Content="Löschen" Click="DeleteDisplayProfile_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="System-Profile">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SystemProfileList" Grid.Column="0"
                             ItemsSource="{Binding SystemProfiles}"
                             SelectedItem="{Binding SelectedSystemProfile}"
                             DisplayMemberPath="Name"
                             MouseDoubleClick="SystemProfileList_MouseDoubleClick"/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="170">
                        <Button Content="Anwenden" Click="ApplySystemProfile_Click"/>
                        <Button Content="Dry-Run" Click="DryRunSystemProfile_Click"/>
                        <Separator Margin="0,8"/>
                        <Button Content="Neu" Click="NewSystemProfile_Click"/>
                        <Button Content="Bearbeiten" Click="EditSystemProfile_Click"/>
                        <Button Content="Duplizieren" Click="DuplicateSystemProfile_Click"/>
                        <Button Content="Löschen" Click="DeleteSystemProfile_Click"/>
                        <Separator Margin="0,8"/>
                        <Button Content="Restore Previous" Click="RestorePrevious_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="1" Header="Log">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Log kopieren" HorizontalAlignment="Right" Click="CopyLog_Click"/>
                <TextBox Grid.Row="1" x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}"
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="LogTextBox_TextChanged"/>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="4" Opacity="0.8"/>
    </Grid>
</Window>
