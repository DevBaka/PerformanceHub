<Window x:Class="ProfileDeck.Wpf.Views.ServicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dienst auswählen" Height="500" Width="620" WindowStartupLocation="CenterOwner"
        Background="#1E1F22" Foreground="#E3E5E8">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="FilterBox" Margin="0,0,0,8" TextChanged="FilterBox_TextChanged"
                  ToolTip="Nach Name filtern"/>

        <ListView Grid.Row="1" x:Name="ServiceListView" MouseDoubleClick="ServiceListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Dienstname" DisplayMemberBinding="{Binding Name}" Width="180"/>
                    <GridViewColumn Header="Anzeigename" DisplayMemberBinding="{Binding DisplayName}" Width="220"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                    <GridViewColumn Header="Starttyp" DisplayMemberBinding="{Binding StartupType}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Übernehmen" Width="90" Click="Take_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
