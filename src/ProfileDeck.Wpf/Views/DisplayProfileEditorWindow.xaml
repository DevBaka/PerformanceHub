<Window x:Class="ProfileDeck.Wpf.Views.DisplayProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display-Profil bearbeiten" Height="500" Width="820"
        Background="#1E1F22" Foreground="#E3E5E8"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="NameBox" Width="260"/>
            <TextBlock Text="Beschreibung:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox x:Name="DescriptionBox" Width="300"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Aktuelle Anordnung laden" Click="LoadCurrent_Click"/>
            <TextBlock Text="Displays mit gleicher Nummer bei 'Spiegeln mit' zeigen dasselbe Bild (Clone); 0 = eigenständig erweitert. Auflösung/Hz/Skalierung über 'Modus...' bearbeiten."
                       VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Monitor" Binding="{Binding FriendlyNameHint}" IsReadOnly="True" Width="140"/>
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Active}" Width="45"/>
                <DataGridCheckBoxColumn Header="Primär" Binding="{Binding Primary}" Width="50"/>
                <DataGridTextColumn Header="X" Binding="{Binding PositionX}" Width="55"/>
                <DataGridTextColumn Header="Y" Binding="{Binding PositionY}" Width="55"/>
                <DataGridTextColumn Header="Auflösung" IsReadOnly="True" Width="80">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}x{1}">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Hz" Binding="{Binding RefreshRateHz}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Skalierung" Binding="{Binding DpiScalePercent, TargetNullValue='—', StringFormat={}{0}%}" IsReadOnly="True" Width="70"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Modus..." Padding="6,2" FontSize="11" Click="EditMode_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Spiegeln mit" Binding="{Binding Group}" Width="80"/>
                <DataGridTextColumn Header="Hardware-Id" Binding="{Binding HardwareId}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Speichern" Width="90" Click="Save_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
