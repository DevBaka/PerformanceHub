<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskrig.Desktop.Views.DisplayModeDialog"
        Title="Anzeigemodus" Height="350" Width="420" WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Foreground}">
    <StackPanel Margin="16">
        <TextBlock Name="MonitorNameText" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="Dropdown zeigt nur Werte, die dieser Monitor laut Treiber tatsächlich unterstützt. Freies Eintippen bleibt trotzdem möglich - auf eigenes Risiko."
                   TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,0,0,14"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Seitenverhältnis:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Name="RatioCombo" Margin="0,4" HorizontalAlignment="Stretch" SelectionChanged="RatioCombo_SelectionChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Auflösung:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Name="ResolutionCombo" Margin="0,4" HorizontalAlignment="Stretch" IsEditable="True"
                      SelectionChanged="ResolutionCombo_SelectionChanged"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bildwiederholrate:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Name="RefreshCombo" Margin="0,4" HorizontalAlignment="Stretch" IsEditable="True"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Skalierung:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Name="ScalingCombo" Margin="0,4" HorizontalAlignment="Stretch" IsEditable="True"/>
        </Grid>

        <TextBlock Name="HintText" Margin="0,10,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Übernehmen" Width="100" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
