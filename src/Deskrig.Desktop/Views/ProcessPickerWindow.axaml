<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskrig.Desktop.Views.ProcessPickerWindow"
        Title="Programm auswählen" Height="500" Width="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Foreground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Aktualisieren" Click="Refresh_Click"/>
            <Button Content="Datei wählen..." Click="BrowseFile_Click"/>
            <TextBox Name="FilterBox" Width="220" Margin="16,2,2,2" TextChanged="FilterBox_TextChanged"
                     Watermark="Nach Name filtern"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" DoubleTapped="ProcessGrid_DoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Übernehmen" Width="90" Click="Take_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
