<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskrig.Desktop.Views.SystemProfileEditorWindow"
        Title="System-Profil bearbeiten" Height="820" Width="920" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Foreground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Text="Allgemein" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Name:" VerticalAlignment="Center" Width="120"/>
                            <TextBox Name="NameBox" Width="260"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Beschreibung:" VerticalAlignment="Center" Width="120"/>
                            <TextBox Name="DescriptionBox" Width="400"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Display-Profil:" VerticalAlignment="Center" Width="120"/>
                            <ComboBox Name="DisplayProfileCombo" Width="220"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hotkey:" VerticalAlignment="Center" Width="120"/>
                            <TextBox Name="HotkeyBox" Width="180" ToolTip.Tip="z.B. Ctrl+Alt+D1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Text="Programme starten (Reihenfolge per Drag &amp; Drop)" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Aus laufenden Prozessen / Datei..." Click="AddProgram_Click"/>
                            <Button Content="Entfernen" Click="RemoveProgram_Click"/>
                        </StackPanel>
                        <DataGrid Name="ProgramsGrid" AutoGenerateColumns="False" CanUserResizeColumns="True"
                                  Height="180" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="220"/>
                                <DataGridTextColumn Header="Argumente" Binding="{Binding Arguments}" Width="120"/>
                                <DataGridTextColumn Header="Arbeitsverz." Binding="{Binding WorkingDirectory}" Width="120"/>
                                <DataGridTextColumn Header="Delay (ms)" Binding="{Binding DelayAfterMs}" Width="70"/>
                                <DataGridTextColumn Header="Priorität" Binding="{Binding Priority}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Admin" Binding="{Binding RunAsAdmin}" Width="50"/>
                                <DataGridCheckBoxColumn Header="Warten auf Fenster" Binding="{Binding WaitForWindow}" Width="60"/>
                                <DataGridCheckBoxColumn Header="Skip falls läuft" Binding="{Binding SkipIfAlreadyRunning}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Text="Prozesse beenden (vor dem Start)" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Aus laufenden Prozessen..." Click="AddKillProcess_Click"/>
                            <Button Content="Manuell hinzufügen" Click="AddKillProcessManual_Click"/>
                            <Button Content="Entfernen" Click="RemoveKillProcess_Click"/>
                        </StackPanel>
                        <ListBox Name="KillList" Height="70"/>
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Name="ServicesHeader" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Dienst hinzufügen..." Click="AddService_Click"/>
                            <Button Content="Entfernen" Click="RemoveService_Click"/>
                        </StackPanel>
                        <DataGrid Name="ServicesGrid" AutoGenerateColumns="False" Height="120"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dienst" Binding="{Binding ServiceName}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ziel-Status (NoChange/Start/Stop)" Binding="{Binding DesiredState}" Width="220"/>
                                <DataGridTextColumn Header="Starttyp (leer/Automatic/Manual/Disabled)" Binding="{Binding StartupType}" Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Name="SettingsSection" Classes="section">
                    <StackPanel>
                        <TextBlock Text="Systemeinstellungen" Classes="sectionHeader"/>
                        <StackPanel Name="SettingsPanel"/>
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Name="PowerSectionHeader" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Power-Plan:" VerticalAlignment="Center" Width="160"/>
                            <ComboBox Name="PowerPlanCombo" Width="260"/>
                        </StackPanel>
                        <StackPanel Name="SchedulingRow" Orientation="Horizontal">
                            <TextBlock Text="Prozessor-Scheduling:" VerticalAlignment="Center" Width="160"/>
                            <ComboBox Name="SchedulingCombo" Width="260"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Text="Prozess-Priorität (laufende Prozesse)" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Aus laufenden Prozessen..." Click="AddPriority_Click"/>
                            <Button Content="Entfernen" Click="RemovePriority_Click"/>
                        </StackPanel>
                        <DataGrid Name="PriorityGrid" AutoGenerateColumns="False" Height="100"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prozess" Binding="{Binding ProcessName}" Width="220"/>
                                <DataGridTextColumn Header="Priorität (Idle/BelowNormal/Normal/AboveNormal/High/Realtime)" Binding="{Binding Priority}" Width="300"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Classes="section">
                    <StackPanel>
                        <TextBlock Text="Audio" Classes="sectionHeader"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Standard-Ausgabe:" VerticalAlignment="Center" Width="160"/>
                            <ComboBox Name="AudioOutputCombo" Width="320"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Standard-Eingabe:" VerticalAlignment="Center" Width="160"/>
                            <ComboBox Name="AudioInputCombo" Width="320"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Speichern" Width="90" Click="Save_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
    </Window.Styles>
</Window>
