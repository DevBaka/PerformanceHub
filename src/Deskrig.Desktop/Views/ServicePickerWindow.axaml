<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Deskrig.Desktop.Views.ServicePickerWindow"
        Title="Dienst auswählen" Height="500" Width="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Foreground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Name="FilterBox" Margin="0,0,0,8" TextChanged="FilterBox_TextChanged"
                  Watermark="Nach Name filtern"/>

        <DataGrid Grid.Row="1" Name="ServiceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" DoubleTapped="ServiceGrid_DoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dienstname" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="220"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Starttyp" Binding="{Binding StartupType}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Übernehmen" Width="90" Click="Take_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
